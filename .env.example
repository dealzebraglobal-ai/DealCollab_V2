# DealCollab — environment variable reference (placeholders only, no real values)
# Copy to .env and fill in. Never commit real secrets.

# App
AUTH_URL=
AUTH_TRUST_HOST=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_ENV=

# Database (Supabase Postgres via Drizzle)
DATABASE_URL=

# Auth.js
NEXTAUTH_SECRET=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# SMS / Admin
FAST2SMS_API_KEY=
ADMIN_API_KEY=
ADMIN_EMAILS=

# Meta WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bot service
BOT_SERVICE_URL=
BOT_SERVICE_SECRET=

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# WappBiz WhatsApp (documented API — see src/lib/whatsapp/wappbiz.ts)
WAPPBIZ_API_KEY=
WAPPBIZ_API_URL=
WAPPBIZ_PHONE_NUMBER=
# Optional — pins a specific approved auth template for OTP delivery via
# sendAuthTemplate; if unset, the first template from fetchAuthTemplates is used.
WAPPBIZ_OTP_TEMPLATE_NAME=

# Google Analytics 4 — omit entirely to disable analytics (no script loads without it)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
